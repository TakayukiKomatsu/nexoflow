SRM_DB_URL=jdbc:postgresql://localhost:5432/srm_credit_engine
SRM_DB_USERNAME=srm
SRM_DB_PASSWORD=replace-with-local-password
SRM_JWT_SECRET=replace-with-at-least-32-random-bytes
SPRING_PROFILES_ACTIVE=dev
# Set this only when V1-V22 data was written in a different JVM time zone.
SRM_MIGRATION_V23_LEGACY_TIME_ZONE=
SRM_DEV_OPERATOR_EMAIL=operator@srm.local
SRM_DEV_OPERATOR_PASSWORD=replace-with-local-development-password
SRM_DEV_ADMIN_EMAIL=admin@srm.local
SRM_DEV_ADMIN_PASSWORD=replace-with-local-admin-password
VITE_BACKEND_ORIGIN=http://127.0.0.1:8080
POSTGRES_PASSWORD=replace-with-local-password
FRONTEND_PORT=8088
