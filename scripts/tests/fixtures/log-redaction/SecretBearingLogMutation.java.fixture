package com.srm.creditengine.mutation;

import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

final class SecretBearingLogMutation {
    private static final Logger LOG = LoggerFactory.getLogger(SecretBearingLogMutation.class);

    void leak(String password) {
        LOG.atWarn().addKeyValue("password", password).log("SECRET_BEARING_MUTATION");
    }
}
