erDiagram
    users ||--o{ user_roles : has
    assignors ||--o{ receivables : owns
    assignors ||--o{ settlements : receives
    currencies ||--o{ receivables : denominates
    currencies ||--o{ base_rate_versions : configures
    currencies ||--o{ exchange_rates : prices
    currencies ||--o{ settlements : pays
    product_types ||--o{ receivables : classifies
    product_types ||--o{ product_spread_versions : configures
    product_types ||--o{ pricing_quotes : snapshots
    receivables ||--o{ pricing_quotes : receives
    receivables ||--o| settlement_items : settles
    pricing_quotes ||--o| settlement_items : consumes
    settlements ||--|{ settlement_items : contains
    settlements ||--o| settlement_reversals : compensated_by
    settlements ||--o{ idempotency_records : settlement_replay
    settlement_reversals ||--o{ idempotency_records : reversal_replay

    schema_metadata {
        int id PK
        string schema_name UK
        datetime created_at
    }

    users {
        uuid id PK
        string email UK
        string password_hash
        boolean enabled
    }
    user_roles {
        uuid user_id PK,FK
        string role PK
    }
    assignors {
        uuid id PK
        string legal_name
        string normalized_tax_id UK
        boolean active
        datetime created_at
        string created_by
    }
    currencies {
        string code PK
        int decimal_scale
        boolean active
    }
    product_types {
        string code PK
        boolean active
    }
    product_spread_versions {
        uuid id PK
        string product_type_code FK
        decimal_19_10 monthly_spread
        datetime effective_at
        string created_by
    }
    base_rate_versions {
        uuid id PK
        string currency_code FK
        decimal_19_10 monthly_rate
        datetime effective_at
        string created_by
    }
    exchange_rates {
        uuid id PK
        string base_currency_code FK
        string quote_currency_code FK
        decimal_19_10 rate
        string source
        datetime observed_at
        datetime created_at
        string created_by
    }
    runtime_fixture_records {
        string fixture_id PK
        string fixture_set
        string fixture_value
        datetime loaded_at
    }
    receivables {
        uuid id PK
        uuid assignor_id FK
        string product_type_code FK
        string face_currency_code FK
        decimal_19_4 face_amount
        date issue_date
        date due_date
        string status
        bigint version
        datetime created_at
        string created_by
    }
    pricing_quotes {
        uuid id PK
        uuid receivable_id FK
        string settlement_currency_code FK
        decimal_19_4 face_amount
        string face_currency_code FK
        string product_type_code FK
        date due_date
        datetime pricing_at
        datetime expires_at
        decimal_19_10 base_rate
        decimal_19_10 spread
        string strategy_code
        string day_count_convention
        decimal_19_10 term_in_months
        decimal_19_4 discounted_amount
        string fx_base_currency_code FK
        string fx_quote_currency_code FK
        decimal_19_10 fx_rate
        string fx_source
        datetime fx_observed_at
        decimal_19_4 settlement_amount
        string created_by
        string status
    }
    settlements {
        uuid id PK
        uuid assignor_id FK
        string settlement_currency_code FK
        decimal_19_4 total_amount
        string status
        datetime created_at
        string created_by
    }
    settlement_items {
        uuid id PK
        uuid settlement_id FK
        uuid quote_id UK,FK
        uuid receivable_id UK,FK
        int item_position
        decimal_19_4 settlement_amount
        string asset_currency_code FK
        string product_type_code FK
    }
    idempotency_records {
        uuid id PK
        string actor
        string operation
        string idempotency_key
        string request_hash
        uuid settlement_id FK
        uuid reversal_id FK
        string status
        datetime created_at
        datetime completed_at
    }
    settlement_reversals {
        uuid id PK
        uuid settlement_id UK,FK
        string reason
        datetime reversed_at
        string reversed_by
    }
    audit_events {
        uuid id PK
        string actor
        string action
        string target_type
        uuid target_id
        datetime occurred_at
        string correlation_id
        json safe_metadata
    }

    %% PostgreSQL V12-V16 guards make financial snapshots append-only:
    %% exchange_rates and settlement_reversals reject UPDATE and DELETE.
    %% pricing_quotes rejects DELETE and permits only ACTIVE to CONSUMED while every snapshot value stays unchanged.
    %% settlements, settlement_items, and audit_events also reject mutation.
    %% Composite uniqueness: exchange_rates(base, quote, source, observed_at);
    %% idempotency_records(actor, operation, idempotency_key); settlement_items(settlement_id, item_position).
    %% Settlement Ledger Entry is a derived SQL read model, not a stored table.
    %% SETTLEMENT entry_id = md5("SETTLEMENT:" + settlement_item.id) as UUID with a positive signed amount.
    %% REVERSAL entry_id = md5("REVERSAL:" + reversal.id + ":" + settlement_item.id) as UUID with a negative signed amount.
    %% Stable order: effective_at DESC, entry_id DESC.
