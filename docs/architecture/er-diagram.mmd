erDiagram
    users ||--o{ user_roles : has
    assignors ||--o{ receivables : owns
    assignors ||--o{ settlements : receives
    currencies ||--o{ receivables : denominates
    currencies ||--o{ base_rate_versions : configures
    currencies ||--o{ exchange_rates : prices
    currencies ||--o{ settlements : pays
    product_types ||--o{ receivables : classifies
    product_types ||--o{ product_spread_versions : configures
    product_types ||--o{ pricing_quotes : snapshots
    receivables ||--o{ pricing_quotes : receives
    receivables ||--o| settlement_items : settles
    pricing_quotes ||--o| settlement_items : consumes
    settlements ||--|{ settlement_items : contains
    settlements ||--o| settlement_reversals : compensated_by
    settlements ||--o{ idempotency_records : settlement_replay
    settlement_reversals ||--o{ idempotency_records : reversal_replay

    schema_metadata {
        int id PK
        varchar_100 schema_name UK
        timestamptz created_at
    }

    users {
        uuid id PK
        varchar_320 email UK
        varchar_100 password_hash
        boolean enabled
    }
    user_roles {
        uuid user_id PK,FK
        varchar_30 role PK
    }
    assignors {
        uuid id PK
        varchar_200 legal_name
        varchar_32 normalized_tax_id UK
        boolean active
        timestamptz created_at
        varchar_320 created_by
    }
    currencies {
        varchar_3 code PK
        int decimal_scale
        boolean active
    }
    product_types {
        varchar_50 code PK
        boolean active
    }
    product_spread_versions {
        uuid id PK
        varchar_50 product_type_code FK
        decimal_19_10 monthly_spread
        timestamptz effective_at
        varchar_320 created_by
    }
    base_rate_versions {
        uuid id PK
        varchar_3 currency_code FK
        decimal_19_10 monthly_rate
        timestamptz effective_at
        varchar_320 created_by
    }
    exchange_rates {
        uuid id PK
        varchar_3 base_currency_code FK
        varchar_3 quote_currency_code FK
        decimal_19_10 rate
        varchar_50 source
        timestamptz observed_at
        timestamptz created_at
        varchar_320 created_by
    }
    runtime_fixture_records {
        varchar_100 fixture_id PK
        varchar_100 fixture_set
        varchar_500 fixture_value
        timestamptz loaded_at
    }
    receivables {
        uuid id PK
        uuid assignor_id FK
        varchar_50 product_type_code FK
        varchar_3 face_currency_code FK
        decimal_19_4 face_amount
        date issue_date
        date due_date
        varchar_20 status
        bigint version
        timestamptz created_at
        varchar_320 created_by
    }
    pricing_quotes {
        uuid id PK
        uuid receivable_id FK
        varchar_3 settlement_currency_code FK
        decimal_19_4 face_amount
        varchar_3 face_currency_code FK
        varchar_50 product_type_code FK
        date due_date
        timestamptz pricing_at
        timestamptz expires_at
        decimal_19_10 base_rate
        decimal_19_10 spread
        varchar_50 strategy_code
        varchar_50 day_count_convention
        decimal_19_10 term_in_months
        decimal_19_4 discounted_amount
        varchar_3 fx_base_currency_code FK
        varchar_3 fx_quote_currency_code FK
        decimal_19_10 fx_rate
        varchar_100 fx_source
        timestamptz fx_observed_at
        decimal_19_4 settlement_amount
        varchar_320 created_by
        varchar_20 status
    }
    settlements {
        uuid id PK
        uuid assignor_id FK
        varchar_3 settlement_currency_code FK
        decimal_19_4 total_amount
        varchar_20 status
        timestamptz created_at
        varchar_320 created_by
    }
    settlement_items {
        uuid id PK
        uuid settlement_id FK
        uuid quote_id UK,FK
        uuid receivable_id UK,FK
        int item_position
        decimal_19_4 settlement_amount
        varchar_3 asset_currency_code FK
        varchar_50 product_type_code FK
    }
    idempotency_records {
        uuid id PK
        varchar_320 actor
        varchar_100 operation
        varchar_200 idempotency_key
        char_64 request_hash
        uuid settlement_id FK
        uuid reversal_id FK
        varchar_20 status
        timestamptz created_at
        timestamptz completed_at
    }
    settlement_reversals {
        uuid id PK
        uuid settlement_id UK,FK
        varchar_500 reason
        timestamptz reversed_at
        varchar_320 reversed_by
    }
    audit_events {
        uuid id PK
        varchar_320 actor
        varchar_80 action
        varchar_80 target_type
        uuid target_id
        timestamptz occurred_at
        varchar_100 correlation_id
        json safe_metadata
    }

    %% varchar_N and char_N encode exact SQL length bounds; timestamptz means
    %% PostgreSQL timestamp with time zone rather than timestamp without time zone.
    %% V23 interprets application rows in the configured legacy writer zone;
    %% six immutable Flyway reference-rate seed IDs retain UTC provenance.
    %% PostgreSQL V12-V16 and V23 guards protect financial state:
    %% exchange_rates and settlement_reversals reject UPDATE and DELETE.
    %% pricing_quotes rejects DELETE and permits only ACTIVE to CONSUMED while every snapshot value stays unchanged.
    %% settlements, settlement_items, and audit_events also reject mutation.
    %% idempotency_records permits only PROCESSING to COMPLETED with immutable request identity,
    %% rejects processing-row deletion and completed-row updates, and permits completed retention deletion.
    %% Composite uniqueness: exchange_rates(base, quote, source, observed_at);
    %% idempotency_records(actor, operation, idempotency_key); settlement_items(settlement_id, item_position).
    %% Settlement Ledger Entry is a derived SQL read model, not a stored table.
    %% SETTLEMENT entry_id = md5("SETTLEMENT:" + settlement_item.id) as UUID with a positive signed amount.
    %% REVERSAL entry_id = md5("REVERSAL:" + reversal.id + ":" + settlement_item.id) as UUID with a negative signed amount.
    %% Stable order: effective_at DESC, entry_id DESC.
